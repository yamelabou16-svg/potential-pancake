'use client';

import React, { useState, useMemo, useEffect, useCallback } from 'react';
import {
    Plus,
    Trash2,
    DollarSign,
    ArrowUpCircle,
    ArrowDownCircle,
    Pencil,
    Target,
    Calculator,
    Calendar,
    Zap,
    Bug,
    Eye,
    EyeOff,
    TrendingUp,
    BarChart3,
    Sun,
    Moon,
    Palette,
    Gem
} from 'lucide-react';
import {
    BarChart,
    Bar,
    XAxis,
    YAxis,
    Tooltip,
    ResponsiveContainer,
    Cell
} from 'recharts';

// --- Types ---
type ThemeMode = 'light' | 'dark' | 'blue';

interface Movement {
    id: string; concept: string; category: string; amount: number;
}
interface SavingsGoal { name: string; amount: number; }
interface UpcomingPayment { id: string; name: string; amount: number; dueDate: string; }
interface AntExpense { id: string; name: string; monthlyAmount: number; }

const MOVEMENTS_KEY = 'finance_movements_v2';
const GOAL_KEY = 'finance_goal_v2';
const SIM_KEY = 'finance_sim_v2';
const PAYMENTS_KEY = 'finance_payments_v2';
const ANT_KEY = 'finance_ant_v2';
const PRIVACY_KEY = 'finance_privacy_v2';
const THEME_KEY = 'finance_theme_v2';

// --- Theme Configurations ---
const THEMES = {
    light: {
        bg: 'bg-slate-50',
        card: 'bg-white',
        text: 'text-slate-900',
        subText: 'text-slate-400',
        border: 'border-slate-100',
        chartLine: '#94A3B8',
        cardShadow: 'shadow-xl shadow-slate-100/50',
        inputBg: 'bg-slate-50'
    },
    dark: {
        bg: 'bg-[#0F172A]',
        card: 'bg-slate-800',
        text: 'text-slate-100',
        subText: 'text-slate-400',
        border: 'border-slate-700',
        chartLine: '#64748B',
        cardShadow: 'shadow-2xl shadow-black/20',
        inputBg: 'bg-slate-900'
    },
    blue: {
        bg: 'bg-[#1E3A8A]',
        card: 'bg-blue-800',
        text: 'text-blue-50',
        subText: 'text-blue-300',
        border: 'border-blue-700',
        chartLine: '#93C5FD',
        cardShadow: 'shadow-2xl shadow-blue-950/40',
        inputBg: 'bg-blue-900'
    }
};

const INITIAL_MOVEMENTS: Movement[] = [
    { id: '1', concept: 'Salario', category: 'Ingreso', amount: 3000 },
    { id: '2', concept: 'Renta', category: 'Gasto', amount: -800 },
    { id: '3', concept: 'Comida', category: 'Gasto', amount: -400 },
    { id: '4', concept: 'Freelance', category: 'Ingreso', amount: 500 },
];

export default function DashboardFinanzas() {
    const [movements, setMovements] = useState<Movement[]>([]);
    const [goal, setGoal] = useState<SavingsGoal>({ name: 'Libertad Financiera', amount: 15000 });
    const [payments, setPayments] = useState<UpcomingPayment[]>([]);
    const [antExpenses, setAntExpenses] = useState<AntExpense[]>([]);
    const [isPrivacy, setIsPrivacy] = useState(false);
    const [theme, setTheme] = useState<ThemeMode>('light');
    const [isLoaded, setIsLoaded] = useState(false);

    // Modals
    const [showForm, setShowForm] = useState(false);
    const [showGoalForm, setShowGoalForm] = useState(false);
    const [showSim, setShowSim] = useState(false);
    const [showPaymentForm, setShowPaymentForm] = useState(false);
    const [showAntForm, setShowAntForm] = useState(false);

    // Logic States
    const [simRate, setSimRate] = useState(10);
    const [simYears, setSimYears] = useState(5);
    const [newConcept, setNewConcept] = useState('');
    const [newCategory, setNewCategory] = useState('Gasto');
    const [newAmount, setNewAmount] = useState('');
    const [tempGoalName, setTempGoalName] = useState('');
    const [tempGoalAmount, setTempGoalAmount] = useState('');
    const [payName, setPayName] = useState('');
    const [payAmount, setPayAmount] = useState('');
    const [payDate, setPayDate] = useState('');
    const [antName, setAntName] = useState('');
    const [antMonthly, setAntMonthly] = useState('');

    const T = THEMES[theme];

    // --- Persistence ---
    useEffect(() => {
        const load = (k: string, d: any) => {
            if (typeof window === 'undefined') return d;
            const s = localStorage.getItem(k);
            if (s === null) return d;
            try {
                return JSON.parse(s);
            } catch (e) {
                console.error(`Error parsing localStorage key ${k}`, e);
                return d;
            }
        };

        const savedMovements = load(MOVEMENTS_KEY, null);
        setMovements(savedMovements !== null ? savedMovements : INITIAL_MOVEMENTS);

        setGoal(load(GOAL_KEY, { name: 'Libertad Financiera', amount: 15000 }));
        setPayments(load(PAYMENTS_KEY, []));
        setAntExpenses(load(ANT_KEY, []));
        setIsPrivacy(load(PRIVACY_KEY, false));

        const savedTheme = localStorage.getItem(THEME_KEY);
        if (savedTheme) setTheme(savedTheme as ThemeMode);

        const savedSim = localStorage.getItem(SIM_KEY);
        if (savedSim) {
            try {
                const p = JSON.parse(savedSim);
                setSimRate(p.rate); setSimYears(p.years);
            } catch (e) { }
        }
        setIsLoaded(true);
    }, []);

    useEffect(() => {
        if (isLoaded) {
            localStorage.setItem(MOVEMENTS_KEY, JSON.stringify(movements));
            localStorage.setItem(GOAL_KEY, JSON.stringify(goal));
            localStorage.setItem(SIM_KEY, JSON.stringify({ rate: simRate, years: simYears }));
            localStorage.setItem(PAYMENTS_KEY, JSON.stringify(payments));
            localStorage.setItem(ANT_KEY, JSON.stringify(antExpenses));
            localStorage.setItem(PRIVACY_KEY, JSON.stringify(isPrivacy));
            localStorage.setItem(THEME_KEY, theme);
        }
    }, [movements, goal, simRate, simYears, payments, antExpenses, isPrivacy, theme, isLoaded]);

    // --- Analytics ---
    const stats = useMemo(() => {
        let income = 0; let expenses = 0;
        movements.forEach(m => m.amount > 0 ? income += m.amount : expenses += Math.abs(m.amount));
        const balance = income - expenses;
        const eff = income > 0 ? (balance / income) * 100 : 0;
        const progress = Math.min((balance / goal.amount) * 100, 100);
        const r = simRate / 100; const t = simYears;
        const fvInvestment = balance > 0 ? balance * Math.pow(1 + r, t) : 0;
        let antM = 0; antExpenses.forEach(a => {
            // Backward compatibility: handle dailyAmount if monthlyAmount is missing
            const val = (a as any).monthlyAmount ?? (a as any).dailyAmount ?? 0;
            antM += val;
        });
        return { income, expenses, balance, eff, progress, fvInvestment, totalAnt: antM * 12, antM };
    }, [movements, goal, simRate, simYears, antExpenses]);

    const chartData = useMemo(() => [
        { name: 'Ingresos', v: stats.income, c: '#10B981' },
        { name: 'Gastos', v: stats.expenses, c: '#F87171' }
    ], [stats]);

    const incomes = useMemo(() => movements.filter(m => m.amount > 0), [movements]);
    const outcomes = useMemo(() => movements.filter(m => m.amount < 0), [movements]);

    const format = useCallback((v: number) => {
        if (isPrivacy) return '••••';
        return `$${Math.round(v).toLocaleString()}`;
    }, [isPrivacy]);

    const getDaysUntil = (dateStr: string) => {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const target = new Date(dateStr);
        target.setHours(0, 0, 0, 0);
        const diff = target.getTime() - today.getTime();
        return Math.ceil(diff / (1000 * 60 * 60 * 24));
    };

    const sortedPayments = useMemo(() => {
        return [...payments].sort((a, b) => new Date(a.dueDate).getTime() - new Date(b.dueDate).getTime());
    }, [payments]);

    // --- Handlers ---
    const handleReset = () => {
        console.log("Reset requested...");
        if (confirm('¿Estás seguro? Esta acción borrará permanentemente todos tus ingresos, gastos y metas.')) {
            console.log("Reset confirmed. Clearing localStorage...");
            const keys = [
                'ethereal_movements',
                'ethereal_goal',
                'ethereal_payments',
                'ethereal_ant',
                'ethereal_privacy',
                'ethereal_theme',
                'ethereal_sim_rate',
                'ethereal_sim_years'
            ];
            keys.forEach(k => localStorage.removeItem(k));
            localStorage.clear(); // Fallback
            console.log("Clearing complete. Reloading...");
            window.location.href = window.location.pathname;
        }
    };
    const handleAdd = (e: React.FormEvent) => {
        e.preventDefault();
        if (!newConcept || !newAmount) return;
        const amt = parseFloat(newAmount);
        const final = newCategory === 'Ingreso' ? Math.abs(amt) : -Math.abs(amt);
        setMovements(p => [{ id: Date.now().toString(), concept: newConcept, category: newCategory, amount: final }, ...p]);
        setNewConcept(''); setNewAmount(''); setShowForm(false);
    };

    if (!isLoaded) return null;

    return (
        <div className={`min-h-screen ${T.bg} transition-colors duration-500`}>
            <main className="p-4 md:p-8 max-w-7xl mx-auto space-y-8 animate-in fade-in duration-700 pb-20">

                {/* Top Bar */}
                <header className="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                    <div className="flex items-center gap-5">
                        <div className={`w-14 h-14 ${theme === 'light' ? 'bg-indigo-600' : 'bg-emerald-500'} rounded-2xl shadow-lg flex items-center justify-center text-white`}>
                            <Gem size={32} strokeWidth={2.5} />
                        </div>
                        <div>
                            <h1 className={`text-4xl md:text-5xl font-black ${T.text} tracking-tighter`}>Ethereal Assets</h1>
                            <p className={`${T.subText} font-bold uppercase text-[10px] tracking-[0.3em] mt-1`}>Financial Intel System</p>
                        </div>
                    </div>

                    <div className="flex items-center gap-2">
                        <div className={`flex items-center gap-1 p-1.5 ${T.card} rounded-2xl border ${T.border} shadow-sm`}>
                            <ThemeBtn key="light" active={theme === 'light'} onClick={() => setTheme('light')} icon={<Sun size={20} />} />
                            <ThemeBtn key="dark" active={theme === 'dark'} onClick={() => setTheme('dark')} icon={<Moon size={20} />} />
                            <ThemeBtn key="blue" active={theme === 'blue'} onClick={() => setTheme('blue')} icon={<Palette size={20} />} />
                        </div>
                        <button
                            onClick={() => setIsPrivacy(!isPrivacy)}
                            className={`p-4 rounded-2xl transition-all ${isPrivacy ? 'bg-indigo-600 text-white' : `${T.card} ${T.subText} hover:text-indigo-600 border ${T.border}`}`}
                        >
                            {isPrivacy ? <EyeOff size={24} /> : <Eye size={24} />}
                        </button>
                        <button onClick={() => setShowForm(true)} className="bg-emerald-500 text-white px-8 py-4 rounded-2xl font-black shadow-xl hover:bg-emerald-600 hover:-translate-y-1 transition-all flex items-center gap-2">
                            <Plus size={24} strokeWidth={3} /> Nuevo
                        </button>
                    </div>
                </header>

                {/* Hero Cards */}
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <StatCard title="Ingresos" value={stats.income} icon={<ArrowUpCircle />} color="emerald" theme={T} format={format} />
                    <StatCard title="Gastos" value={stats.expenses} icon={<ArrowDownCircle />} color="coral" theme={T} format={format} isNeg />
                    <StatCard title="Balance" value={stats.balance} icon={<DollarSign />} color="indigo" theme={T} format={format} isNeg={stats.balance < 0} />
                    <StatCard title="Capital Proyectado" value={stats.fvInvestment} icon={<TrendingUp />} color="blue" theme={T} format={format} />
                </div>

                {/* Projections & Charts */}
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <div className="lg:col-span-12 xl:col-span-5">
                        <div className={`${T.card} p-8 md:p-10 rounded-[48px] border ${T.border} ${theme === 'dark' ? 'shadow-[0_0_30px_rgba(16,185,129,0.1)]' : 'shadow-xl shadow-slate-200/50'} h-full flex flex-col`}>
                            <div className="flex items-center gap-4 mb-10">
                                <div className={`p-4 ${theme === 'light' ? 'bg-emerald-50 text-emerald-600' : 'bg-emerald-900/40 text-emerald-400'} rounded-3xl`}><BarChart3 size={32} /></div>
                                <div>
                                    <h3 className={`text-2xl font-black ${T.text} tracking-tighter`}>Proyección</h3>
                                    <p className={`${T.subText} text-[10px] font-bold uppercase tracking-[0.2em] mt-1`}>Calculador de Interés Compuesto</p>
                                </div>
                            </div>

                            {/* Section: Inputs */}
                            <div className="space-y-8 mb-10">
                                <div className="space-y-4">
                                    <div className="flex justify-between items-center px-1">
                                        <label className={`text-[11px] font-black ${T.subText} uppercase tracking-widest`}>Tasa Anual</label>
                                        <span className={`text-sm font-black ${theme === 'light' ? 'text-indigo-600' : 'text-emerald-400'}`}>{simRate}% Anual</span>
                                    </div>
                                    <input
                                        type="range" min="0" max="30" step="0.5"
                                        value={simRate} onChange={e => setSimRate(parseFloat(e.target.value))}
                                        className="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500"
                                    />
                                </div>
                                <div className="space-y-4">
                                    <div className="flex justify-between items-center px-1">
                                        <label className={`text-[11px] font-black ${T.subText} uppercase tracking-widest`}>Tiempo</label>
                                        <span className={`text-sm font-black ${theme === 'light' ? 'text-indigo-600' : 'text-emerald-400'}`}>{simYears} Años</span>
                                    </div>
                                    <input
                                        type="range" min="1" max="50"
                                        value={simYears} onChange={e => setSimYears(parseInt(e.target.value))}
                                        className="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500"
                                    />
                                </div>
                            </div>

                            {/* Section: Result */}
                            <div className={`mt-auto p-8 rounded-[36px] ${theme === 'light' ? 'bg-slate-50 border-slate-100' : 'bg-black/20 border-slate-700/50'} border relative overflow-hidden group transition-all duration-300`}>
                                <div className="relative z-10">
                                    <p className={`text-[10px] font-black ${T.subText} uppercase tracking-widest mb-2`}>Capital Final Estimado</p>
                                    <p className={`text-5xl font-black text-emerald-500 tracking-tighter transition-all duration-300 tabular-nums`}>
                                        {format(stats.fvInvestment)}
                                    </p>
                                    <div className="mt-4 flex items-center gap-2">
                                        <div className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                                        <p className={`text-[9px] font-bold ${T.subText} uppercase tracking-wider`}>
                                            Basado en tu capital inicial de {format(stats.balance)}
                                        </p>
                                    </div>
                                </div>
                                <TrendingUp className={`absolute -right-6 -bottom-6 ${theme === 'light' ? 'text-emerald-500/5' : 'text-emerald-500/10'}`} size={140} />
                            </div>
                        </div>
                    </div>
                    <div className="lg:col-span-12 xl:col-span-7">
                        <div className={`${T.card} p-10 rounded-[48px] border ${T.border} ${T.cardShadow} h-[450px] min-h-[450px] flex flex-col`}>
                            <h2 className={`text-2xl font-black ${T.text} tracking-tighter mb-8`}>Historial de Flujo</h2>
                            <div className="flex-1 w-full">
                                <ResponsiveContainer width="100%" height="100%">
                                    <BarChart data={chartData} margin={{ top: 10, right: 10, left: 0, bottom: 20 }}>
                                        <XAxis
                                            dataKey="name"
                                            axisLine={false}
                                            tickLine={false}
                                            tick={{ fill: theme === 'light' ? '#475569' : '#94A3B8', fontSize: 13, fontWeight: 800 }}
                                            dy={10}
                                        />
                                        <YAxis
                                            axisLine={false}
                                            tickLine={false}
                                            tick={{ fill: theme === 'light' ? '#64748B' : '#64748B', fontSize: 12, fontWeight: 600 }}
                                            hide={isPrivacy}
                                            width={40}
                                        />
                                        <Tooltip
                                            cursor={{ fill: theme === 'light' ? '#F1F5F9' : '#1E293B' }}
                                            contentStyle={{
                                                backgroundColor: theme === 'light' ? '#FFFFFF' : '#0F172A',
                                                borderRadius: '20px',
                                                border: `1px solid ${theme === 'light' ? '#F1F5F9' : '#1E293B'}`,
                                                boxShadow: '0 10px 15px -3px rgba(0, 0, 0, 0.1)',
                                                color: theme === 'light' ? '#1E293B' : '#F8FAFC',
                                                fontSize: '12px',
                                                fontWeight: 'bold'
                                            }}
                                        />
                                        <Bar dataKey="v" radius={[12, 12, 12, 12]} barSize={50}>
                                            {chartData.map((e, i) => <Cell key={i} fill={e.c} />)}
                                        </Bar>
                                    </BarChart>
                                </ResponsiveContainer>
                            </div>
                        </div>
                    </div>
                </div>

                {/* Split Movements */}
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <Column title="Ingresos" data={incomes} color="emerald" icon={<ArrowUpCircle />} theme={T} format={format} isPrivacy={isPrivacy} onDel={(id: string) => setMovements(p => p.filter(x => x.id !== id))} total={stats.income} />
                    <Column title="Gastos" data={outcomes} color="rose" icon={<ArrowDownCircle />} theme={T} format={format} isPrivacy={isPrivacy} onDel={(id: string) => setMovements(p => p.filter(x => x.id !== id))} total={stats.expenses} />
                </div>

                {/* Sub-Rows */}
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <div className="lg:col-span-12 xl:col-span-4">
                        <div className={`${T.card} p-8 rounded-[40px] border ${T.border} ${T.cardShadow}`}>
                            <div className="flex justify-between items-center mb-6">
                                <div className="flex items-center gap-3">
                                    <div className={`p-3 ${theme === 'light' ? 'bg-amber-50 text-amber-500' : 'bg-amber-900/30 text-amber-500'} rounded-2xl`}><Bug size={24} /></div>
                                    <div className={`font-black ${T.text} tracking-tight`}>Fugas Hormiga</div>
                                </div>
                                <button onClick={() => setShowAntForm(true)} className={`p-2 ${T.inputBg} ${T.subText} hover:text-amber-500 rounded-xl transition-all`}><Plus size={18} /></button>
                            </div>
                            <div className="space-y-3">
                                {antExpenses.map(a => (
                                    <div key={a.id} className={`flex justify-between items-center p-3 ${T.inputBg} rounded-2xl group`}>
                                        <span className={`text-xs font-bold ${T.text}`}>{a.name}</span>
                                        <div className="flex items-center gap-2">
                                            <span className="text-xs font-black text-rose-500">{format(((a as any).monthlyAmount || (a as any).dailyAmount || 0) * 12)}</span>
                                            <button onClick={() => setAntExpenses(p => p.filter(x => x.id !== a.id))} className="opacity-0 group-hover:opacity-100 text-rose-400 hover:text-rose-600 transition-all"><Trash2 size={12} /></button>
                                        </div>
                                    </div>
                                ))}
                            </div>
                            <div className="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center">
                                <span className={`text-[9px] font-black ${T.subText} uppercase tracking-widest`}>Impacto Anual</span>
                                <span className={`text-xl font-black text-rose-500`}>{format(stats.totalAnt)}</span>
                            </div>
                        </div>
                    </div>

                    <div className="lg:col-span-12 xl:col-span-4">
                        <div className={`relative overflow-hidden p-8 rounded-[44px] border ${T.border} ${T.card} ${T.cardShadow} h-full group hover:shadow-2xl transition-all duration-500 flex flex-col justify-between`}>
                            {/* Decorative Background Glows */}
                            <div className="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-[40px] -mr-16 -mt-16 group-hover:bg-emerald-500/20 transition-all duration-700"></div>
                            <div className="absolute bottom-0 left-0 w-32 h-32 bg-indigo-500/10 rounded-full blur-[40px] -ml-16 -mb-16 group-hover:bg-indigo-500/20 transition-all duration-700"></div>

                            <div className="relative z-10 space-y-8">
                                <div className="flex justify-between items-center">
                                    <div className="flex items-center gap-4">
                                        <div className={`p-3.5 ${theme === 'light' ? 'bg-emerald-50 text-emerald-600 shadow-sm' : 'bg-emerald-500/20 text-emerald-400'} rounded-[20px] group-hover:scale-110 group-hover:rotate-3 transition-all`}>
                                            <Target size={24} strokeWidth={2.5} />
                                        </div>
                                        <div>
                                            <h3 className={`text-xl font-black ${T.text} tracking-tight`}>{goal.name}</h3>
                                            <p className={`${T.subText} text-[9px] font-bold uppercase tracking-[0.2em] opacity-70`}>Financial Freedom Goal</p>
                                        </div>
                                    </div>
                                    <button
                                        onClick={() => { setTempGoalName(goal.name); setTempGoalAmount(goal.amount.toString()); setShowGoalForm(true); }}
                                        className={`p-2.5 rounded-xl transition-all ${theme === 'light' ? 'hover:bg-slate-100 text-slate-400' : 'hover:bg-slate-700 text-slate-500'}`}
                                    >
                                        <Pencil size={16} />
                                    </button>
                                </div>

                                <div className="space-y-6">
                                    <div className="flex justify-between items-end px-1">
                                        <div>
                                            <p className={`text-[10px] font-black ${T.subText} uppercase tracking-[0.15em] mb-1.5`}>Tu Avance</p>
                                            <p className={`text-4xl font-black ${T.text} tracking-tighter tabular-nums`}>{stats.progress.toFixed(1)}%</p>
                                        </div>
                                        <div className="text-right">
                                            <p className={`text-[10px] font-black ${T.subText} uppercase tracking-[0.15em] mb-1.5`}>Objetivo</p>
                                            <p className={`text-lg font-black ${theme === 'light' ? 'text-indigo-600' : 'text-indigo-400'} tracking-tight`}>{format(goal.amount)}</p>
                                        </div>
                                    </div>

                                    <div className="relative">
                                        <div className={`h-4 w-full ${theme === 'light' ? 'bg-slate-100' : 'bg-slate-900'} rounded-full p-1 shadow-inner`}>
                                            <div
                                                className="h-full rounded-full bg-gradient-to-r from-emerald-400 via-emerald-500 to-indigo-600 relative overflow-hidden transition-all duration-1000 ease-out shadow-lg shadow-emerald-500/20"
                                                style={{ width: `${stats.progress}%` }}
                                            >
                                                <div className="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,0.2)_50%,transparent_75%)] bg-[length:40px_40px] animate-[shimmer_2.5s_linear_infinite]"></div>
                                            </div>
                                        </div>
                                        {/* Floating Progress Bubble */}
                                        {stats.progress > 0 && stats.progress < 100 && (
                                            <div
                                                className="absolute top-[-30px] -translate-x-1/2 transition-all duration-1000 ease-out"
                                                style={{ left: `${stats.progress}%` }}
                                            >
                                                <div className="bg-emerald-500 text-white text-[9px] font-black px-2 py-1 rounded-lg shadow-lg relative">
                                                    {stats.progress.toFixed(0)}%
                                                    <div className="absolute bottom-[-3px] left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-emerald-500 rotate-45"></div>
                                                </div>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>

                            <div className={`mt-8 pt-6 border-t ${T.border} flex justify-between items-center relative z-10`}>
                                <div className="space-y-0.5">
                                    <p className={`text-[9px] font-black ${T.subText} uppercase tracking-widest`}>Faltan para completar</p>
                                    <p className={`text-xl font-black text-emerald-500 tracking-tight`}>{format(Math.max(0, goal.amount - stats.balance))}</p>
                                </div>
                                <div className={`px-4 py-2 rounded-xl ${theme === 'light' ? 'bg-amber-50 text-amber-600' : 'bg-amber-500/10 text-amber-400'} border ${theme === 'light' ? 'border-amber-100' : 'border-amber-500/20'} flex items-center gap-2`}>
                                    <Gem size={14} className="animate-pulse" />
                                    <span className="text-[10px] font-black uppercase tracking-wider italic">Próximo Hito</span>
                                </div>
                            </div>

                            <TrendingUp className="absolute -bottom-6 -right-6 text-emerald-500/5 group-hover:text-emerald-500/10 transition-colors pointer-events-none" size={120} />
                        </div>
                    </div>

                    <div className="lg:col-span-12 xl:col-span-4">
                        <div className={`bg-gradient-to-br ${theme === 'light' ? 'from-indigo-600 to-indigo-800' : 'from-indigo-800 to-black'} p-8 rounded-[40px] text-white flex flex-col h-full shadow-xl relative overflow-hidden group`}>
                            <div className="relative z-10 flex flex-col h-full">
                                <div className="flex justify-between items-center mb-6">
                                    <div className="flex items-center gap-3">
                                        <div className="p-3 bg-white/20 rounded-2xl"><Calendar size={24} /></div>
                                        <div className="font-black tracking-tight">Pagos Próximos</div>
                                    </div>
                                    <button onClick={() => setShowPaymentForm(true)} className="p-2 bg-white/10 rounded-xl hover:bg-white/20 transition-all"><Plus size={18} /></button>
                                </div>
                                <div className="flex-1 overflow-y-auto space-y-4 pr-2 scrollbar-hide min-h-[120px]">
                                    {sortedPayments.length > 0 ? sortedPayments.map(p => {
                                        const days = getDaysUntil(p.dueDate);
                                        const isUrgent = days <= 3;
                                        const dayText = days === 0 ? 'Vence hoy' : days < 0 ? `Venció hace ${Math.abs(days)} días` : `Vence en ${days} días`;

                                        return (
                                            <div key={p.id} className="flex justify-between items-center bg-white/5 p-4 rounded-2xl hover:bg-white/10 transition-all group/pay">
                                                <div>
                                                    <p className="font-black tracking-tight truncate max-w-[150px]">{p.name}</p>
                                                    <p className={`text-[10px] ${isUrgent ? 'text-rose-400 font-black flex items-center gap-1' : 'text-indigo-200 font-bold'} uppercase tracking-widest`}>
                                                        {isUrgent && <Zap size={10} fill="currentColor" />} {dayText}
                                                    </p>
                                                </div>
                                                <div className="text-right flex items-center gap-3">
                                                    <span className={`font-black ${isUrgent && !isPrivacy ? 'text-rose-400' : ''}`}>
                                                        {isPrivacy ? '••••' : format(p.amount)}
                                                    </span>
                                                    <button onClick={() => setPayments(prev => prev.filter(x => x.id !== p.id))} className="opacity-0 group-hover/pay:opacity-100 text-white/50 hover:text-white transition-all">
                                                        <Trash2 size={14} />
                                                    </button>
                                                </div>
                                            </div>
                                        );
                                    }) : (
                                        <div className="h-full flex flex-col items-center justify-center text-center py-6">
                                            <p className="text-indigo-300 font-bold">No hay pagos pendientes</p>
                                            <p className="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Todo al día</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                            <Zap className="text-indigo-400/20 absolute -right-6 -bottom-6 pointer-events-none" size={120} fill="currentColor" />
                        </div>
                    </div>
                </div>

                {/* Legal Footer */}
                <footer className="mt-20 pt-10 border-t border-slate-200/5 max-w-4xl mx-auto text-center space-y-6">
                    <p className={`text-[10px] leading-relaxed ${T.subText} font-medium opacity-60 px-6`}>
                        Nota Legal: Esta herramienta tiene fines estrictamente informativos y organizativos. Los cálculos del simulador son proyecciones matemáticas y no constituyen asesoría financiera profesional ni garantías de rentabilidad. El usuario es responsable de sus propias decisiones económicas.
                    </p>
                    <button
                        onClick={handleReset}
                        className="text-[9px] font-black uppercase tracking-[0.2em] text-rose-500/40 hover:text-rose-500 transition-all hover:scale-105"
                    >
                        Borrar todos los datos
                    </button>
                </footer>

            </main>

            {/* --- Modals --- */}
            {showForm && <Modal title="Nuevo Movimiento" onClose={() => setShowForm(false)} theme={T}>
                <form onSubmit={handleAdd} className="space-y-5">
                    <Input val={newConcept} set={setNewConcept} ph="Concepto (ej. Venta)" theme={T} />
                    <div className="grid grid-cols-2 gap-4">
                        <select value={newCategory} onChange={e => setNewCategory(e.target.value)} className={`w-full p-6 ${T.inputBg} ${T.text} rounded-2xl font-bold border-none outline-none shadow-inner`}>
                            <option>Ingreso</option><option>Gasto</option>
                        </select>
                        <Input val={newAmount} set={setNewAmount} ph="0.00" type="number" theme={T} />
                    </div>
                    <Btn type="submit" label="Confirmar" color="emerald" />
                </form>
            </Modal>}

            {showSim && <Modal title="Ajustes Pro" onClose={() => setShowSim(false)} theme={T}>
                <div className="space-y-8">
                    <div className="space-y-2">
                        <label className={`text-[10px] font-black ${T.subText} uppercase tracking-widest`}>Interés Anual (%)</label>
                        <input type="number" value={simRate} onChange={e => setSimRate(parseFloat(e.target.value) || 0)} className={`w-full ${T.inputBg} ${T.text} text-3xl font-black p-6 rounded-3xl outline-none shadow-inner`} />
                    </div>
                    <div className="space-y-2">
                        <label className={`text-[10px] font-black ${T.subText} uppercase tracking-widest`}>Años a Proyectar</label>
                        <input type="number" value={simYears} onChange={e => setSimYears(parseFloat(e.target.value) || 0)} className={`w-full ${T.inputBg} ${T.text} text-3xl font-black p-6 rounded-3xl outline-none shadow-inner`} />
                    </div>
                    <Btn label="Cerrar y Actualizar" onClick={() => setShowSim(false)} color="indigo" />
                </div>
            </Modal>}

            {showAntForm && <Modal title="Fuga Detectada 🐜" onClose={() => setShowAntForm(false)} theme={T}>
                <form onSubmit={e => {
                    e.preventDefault();
                    setAntExpenses(p => [...p, { id: Date.now().toString(), name: antName, monthlyAmount: parseFloat(antMonthly) }]);
                    setAntName('');
                    setAntMonthly('');
                    setShowAntForm(false);
                }} className="space-y-5">
                    <Input val={antName} set={setAntName} ph="Nombre (ej. Suscripción)" theme={T} />
                    <Input val={antMonthly} set={setAntMonthly} ph="Costo mensual" type="number" theme={T} />
                    <Btn type="submit" label="Registrar" color="amber" />
                </form>
            </Modal>}

            {showGoalForm && <Modal title="Ajustar Meta" onClose={() => setShowGoalForm(false)} theme={T}>
                <form onSubmit={e => { e.preventDefault(); setGoal({ name: tempGoalName, amount: parseFloat(tempGoalAmount) }); setShowGoalForm(false); }} className="space-y-5">
                    <Input val={tempGoalName} set={setTempGoalName} ph="Nombre de meta" theme={T} />
                    <Input val={tempGoalAmount} set={setTempGoalAmount} ph="Monto objetivo" type="number" theme={T} />
                    <Btn type="submit" label="Actualizar" color="indigo" />
                </form>
            </Modal>}

            {showPaymentForm && <Modal title="Agendar Pago" onClose={() => setShowPaymentForm(false)} theme={T}>
                <form onSubmit={e => {
                    e.preventDefault();
                    setPayments(p => [...p, { id: Date.now().toString(), name: payName, amount: parseFloat(payAmount), dueDate: payDate }]);
                    setPayName('');
                    setPayAmount('');
                    setPayDate('');
                    setShowPaymentForm(false);
                }} className="space-y-5">
                    <Input val={payName} set={setPayName} ph="Concepto" theme={T} />
                    <div className="grid grid-cols-2 gap-4">
                        <Input val={payAmount} set={setPayAmount} ph="0.00" type="number" theme={T} />
                        <input type="date" value={payDate} onChange={e => setPayDate(e.target.value)} className={`w-full p-6 ${T.inputBg} ${T.text} font-bold rounded-2xl border-none outline-none shadow-inner`} required />
                    </div>
                    <Btn type="submit" label="Guardar" color="rose" />
                </form>
            </Modal>}

        </div>
    );
}

// --- Components ---

const ThemeBtn = ({ active, onClick, icon }: any) => (
    <button onClick={onClick} className={`p-2.5 rounded-xl transition-all ${active ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-400 hover:bg-slate-100'}`}>
        {icon}
    </button>
);

const StatCard = ({ title, value, icon, color, isNeg, theme, format }: any) => {
    const c: any = { emerald: 'text-emerald-500 bg-emerald-500/10', coral: 'text-rose-500 bg-rose-500/10', indigo: 'text-indigo-500 bg-indigo-500/10', blue: 'text-blue-500 bg-blue-500/10' };
    return (
        <div className={`${theme.card} p-8 rounded-[44px] shadow-sm border ${theme.border} hover:shadow-xl transition-all group hover:-translate-y-1`}>
            <div className={`w-14 h-14 rounded-2xl ${c[color]} flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-inner`}>{icon}</div>
            <p className={`${theme.subText} font-black text-[10px] uppercase tracking-widest`}>{title}</p>
            <p className={`text-3xl font-black mt-1 tracking-tighter ${isNeg ? 'text-rose-500' : theme.text}`}>{format(value)}</p>
        </div>
    );
};

const Column = ({ title, data, color, icon, theme, format, isPrivacy, onDel, total }: any) => {
    const headColor = color === 'emerald' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500';
    const amtColor = color === 'emerald' ? 'text-emerald-500' : 'text-rose-500';
    return (
        <div className={`${theme.card} rounded-[48px] border ${theme.border} ${theme.cardShadow} overflow-hidden flex flex-col h-[500px]`}>
            <div className={`p-8 border-b ${theme.border} flex justify-between items-center ${headColor.split(' ')[0]}`}>
                <div className="flex items-center gap-4">
                    <div className={`p-3 rounded-2xl ${headColor}`}>{icon}</div>
                    <h2 className={`text-2xl font-black ${theme.text} tracking-tight`}>{title}</h2>
                </div>
            </div>
            <div className="overflow-y-auto flex-1 scrollbar-hide">
                <table className="w-full">
                    <tbody className={`divide-y ${theme.border}`}>
                        {data.map((m: any) => (
                            <tr key={m.id} className="hover:opacity-70 transition-all group">
                                <td className="px-8 py-5">
                                    <p className={`font-black tracking-tight ${isPrivacy ? 'blur-sm' : theme.text}`}>{m.concept}</p>
                                    <p className={`text-[9px] font-bold ${amtColor} uppercase tracking-widest mt-0.5`}>{m.category}</p>
                                </td>
                                <td className={`px-4 py-5 text-right font-black ${amtColor} text-lg`}>
                                    {isPrivacy ? '••••' : (color === 'emerald' ? `+$${m.amount.toLocaleString()}` : `-$${Math.abs(m.amount).toLocaleString()}`)}
                                </td>
                                <td className="px-8 py-5 text-right w-10">
                                    <button onClick={() => onDel(m.id)} className={`${theme.subText} hover:text-rose-500 transition-all`}><Trash2 size={16} /></button>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <div className={`p-8 ${theme.inputBg} border-t ${theme.border} flex justify-between items-center mt-auto shadow-inner`}>
                <span className={`text-[10px] font-black ${theme.subText} uppercase tracking-widest`}>Subtotal {title}</span>
                <span className={`text-2xl font-black ${amtColor} tracking-tighter`}>{format(total)}</span>
            </div>
        </div>
    );
};

const Modal = ({ title, children, onClose, theme }: any) => (
    <div className="fixed inset-0 bg-black/60 backdrop-blur-xl z-[100] flex items-center justify-center p-6 animate-in fade-in zoom-in duration-300">
        <div className={`${theme.card} rounded-[48px] p-12 max-w-md w-full shadow-2xl relative overflow-hidden transition-all duration-500`}>
            <div className="flex justify-between items-center mb-10">
                <h3 className={`text-3xl font-black ${theme.text} tracking-tighter italic`}>{title}</h3>
                <button onClick={onClose} className={`${theme.inputBg} p-2 rounded-full ${theme.subText} hover:text-rose-500`}><Plus size={24} className="rotate-45" /></button>
            </div>
            {children}
        </div>
    </div>
);

const Input = ({ val, set, ph, type = "text", theme }: any) => (
    <input value={val} onChange={e => set(e.target.value)} placeholder={ph} type={type} className={`w-full p-6 ${theme.inputBg} ${theme.text} rounded-2xl border-none font-bold outline-none shadow-inner focus:ring-2 focus:ring-indigo-500 transition-all`} required />
);

const Btn = ({ label, color, onClick, type = "button" }: any) => {
    const c: any = { emerald: 'bg-emerald-500 hover:bg-emerald-600 shadow-emerald-500/20', indigo: 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-600/20', amber: 'bg-amber-500 hover:bg-amber-600 shadow-amber-500/20', rose: 'bg-rose-500 hover:bg-rose-600 shadow-rose-500/20' };
    return (
        <button type={type} onClick={onClick} className={`w-full ${c[color]} text-white p-6 rounded-2xl font-black text-xl transition-all shadow-xl active:scale-95`}>{label}</button>
    );
};
